# ABIDE first-class inference runtime
# These values are configured once at deployment time (for example in Coolify).
# End users should not need to choose a provider, paste a key, or enter a model URL
# before using the primary ABIDE Generate/Build flow.
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="llama3.2:latest"
ABIDE_DEFAULT_PROVIDER="ollama"

# Optional BYOK / alternate providers.
# Gemini is NOT required for the default ABIDE experience. Configure only when an
# operator intentionally enables Gemini as an advanced provider.
GEMINI_API_KEY=""

# APP_URL: Public URL where ABIDE is hosted.
APP_URL=""

# Optional custom integration base URLs for explicitly configured model farms.
AI_INTEGRATIONS_GEMINI_BASE_URL=""
AI_INTEGRATIONS_OPENAI_BASE_URL=""

# Veklom Plural Canonical Service Endpoints
VEKLOM_API_URL="https://api.veklom.com"
CAPPO_URL="https://cappo.veklom.com"
GNOMELEDGER_URL="https://pgl.veklom.com"
VNP_URL="https://vnp.veklom.com"

# Cryptographic signing keys (Milestone 1)
# Production values must be injected through the deployment secret store; do not
# use example strings as production secrets.
SEKED_HMAC_SECRET=""
CONSTITUTION_SIGNING_KEY=""
APPROVAL_TOKEN_SECRET=""

# =========================================================================
# REAL-WORLD CONNECTORS & API INTEGRATIONS (Pluggable Ingress/Egress Ports)
# =========================================================================

# Real Database Persistence:
# Provide a PostgreSQL database connection string to activate relational Drizzle ORM.
DATABASE_URL=""

# Real Cryptographic Payment Settlement:
X402_LEDGER_URL=""

# Real TLA+ and Z3 SMT Formal Verification:
VERIFICATION_SERVICE_URL=""

# Real OpenTelemetry Observability:
OTEL_EXPORTER_OTLP_ENDPOINT=""
